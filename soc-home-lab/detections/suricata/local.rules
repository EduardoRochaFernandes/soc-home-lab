# SOC Home Lab — Suricata Local Rules
# File: /etc/suricata/rules/local.rules
#
# SID range: 9000001-9099999 (reserved for local rules)
# These rules complement the ET/Open ruleset.
# Sigma rules in detections/sigma/ are the canonical source.

# ============================================================
# CREDENTIAL ACCESS — T1110.001 SSH Brute Force
# ============================================================

# Detect SSH brute force attempts (threshold: 10 failures in 60s)
alert tcp any any -> $HOME_NET 22 (
  msg:"SOC-LAB T1110.001 SSH Brute Force Attempt";
  flow:to_server,established;
  content:"SSH-";
  threshold:type threshold,track by_src,count 10,seconds 60;
  classtype:attempted-admin;
  sid:9000001;
  rev:1;
  metadata:attack_target Server, created_at 2025_01_01, mitre_tactic credential_access, mitre_technique T1110.001;
)

# ============================================================
# DISCOVERY — T1046 Network Scanning
# ============================================================

# Nmap default scan signature
alert tcp any any -> $HOME_NET any (
  msg:"SOC-LAB T1046 Nmap SYN Scan Detected";
  flags:S;
  threshold:type threshold,track by_src,count 20,seconds 10;
  classtype:network-scan;
  sid:9000010;
  rev:1;
  metadata:mitre_tactic discovery, mitre_technique T1046;
)

# Nmap version detection signature
alert tcp any any -> $HOME_NET any (
  msg:"SOC-LAB T1046 Nmap Version Detection";
  content:"Nmap";
  classtype:network-scan;
  sid:9000011;
  rev:1;
)

# ============================================================
# COMMAND AND CONTROL — T1071 Suspicious Outbound Connections
# ============================================================

# Outbound connection to high-risk ports
alert tcp $HOME_NET any -> !$HOME_NET [4444,1234,31337,8080,9999] (
  msg:"SOC-LAB T1071 Suspicious Outbound Connection — Common C2 Port";
  flow:to_server,established;
  classtype:trojan-activity;
  sid:9000020;
  rev:1;
  metadata:mitre_tactic command_and_control, mitre_technique T1071;
)

# ============================================================
# EXFILTRATION — T1048.003 DNS Tunneling
# ============================================================

# Detect unusually long DNS query names (tunneling indicator)
alert dns any any -> any any (
  msg:"SOC-LAB T1048.003 Possible DNS Tunneling — Long Hostname";
  dns.query;
  byte_test:0,>,52,0,relative,string;
  classtype:policy-violation;
  sid:9000030;
  rev:1;
  metadata:mitre_tactic exfiltration, mitre_technique T1048.003;
)

# High frequency DNS queries (tunneling indicator)
alert dns any any -> any any (
  msg:"SOC-LAB T1048.003 High Frequency DNS Queries — Possible Tunneling";
  threshold:type threshold,track by_src,count 100,seconds 10;
  classtype:policy-violation;
  sid:9000031;
  rev:1;
)

# ============================================================
# LATERAL MOVEMENT — T1021 Remote Services
# ============================================================

# RDP brute force
alert tcp any any -> $HOME_NET 3389 (
  msg:"SOC-LAB T1021.001 RDP Brute Force Attempt";
  flow:to_server;
  threshold:type threshold,track by_src,count 5,seconds 60;
  classtype:attempted-admin;
  sid:9000040;
  rev:1;
  metadata:mitre_tactic lateral_movement, mitre_technique T1021.001;
)

# ============================================================
# WEB ATTACKS — T1190 Exploit Public-Facing Application
# ============================================================

# SQL Injection attempt patterns
alert http any any -> $HTTP_SERVERS any (
  msg:"SOC-LAB T1190 SQL Injection Attempt";
  flow:to_server,established;
  http.uri;
  content:"'";
  pcre:"/(\%27|\'|\-\-|\%23|#)/i";
  classtype:web-application-attack;
  sid:9000050;
  rev:1;
  metadata:mitre_tactic initial_access, mitre_technique T1190;
)

# XSS attempt
alert http any any -> $HTTP_SERVERS any (
  msg:"SOC-LAB T1190 XSS Attempt";
  flow:to_server,established;
  http.uri;
  content:"<script";
  nocase;
  classtype:web-application-attack;
  sid:9000051;
  rev:1;
)

# Directory traversal
alert http any any -> $HTTP_SERVERS any (
  msg:"SOC-LAB T1190 Directory Traversal Attempt";
  flow:to_server,established;
  http.uri;
  content:"../";
  classtype:web-application-attack;
  sid:9000052;
  rev:1;
  metadata:mitre_tactic initial_access, mitre_technique T1190;
)

# ============================================================
# MALWARE/C2 — Known Bad User Agents
# ============================================================

alert http $HOME_NET any -> any any (
  msg:"SOC-LAB Suspicious User Agent — Possible Implant";
  flow:to_server,established;
  http.user_agent;
  content:"python-requests";
  threshold:type threshold,track by_src,count 20,seconds 60;
  classtype:trojan-activity;
  sid:9000060;
  rev:1;
)

# ============================================================
# FIREWALL BYPASS — T1572 Protocol Tunneling
# ============================================================

# HTTP over non-standard port
alert tcp $HOME_NET any -> !$HOME_NET [80,443,8080,8443] (
  msg:"SOC-LAB T1572 HTTP Traffic on Non-Standard Port";
  flow:to_server,established;
  app-layer-protocol:http;
  classtype:policy-violation;
  sid:9000070;
  rev:1;
  metadata:mitre_tactic command_and_control, mitre_technique T1572;
)
